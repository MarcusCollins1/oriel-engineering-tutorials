
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /tutorials/{tutorialId} {

      // Anyone can view tutorials.
      allow read: if true;

      // Anyone can create a tutorial with the expected fields.
      allow create: if
        request.resource.data.keys().hasAll([
          "course",
          "module",
          "topic",
          "date",
          "startTime",
          "endTime",
          "location",
          "createdBy",
          "createdByName",
          "attendees",
          "createdAt"
        ])
        && request.resource.data.course in [
          "A1", "A2", "A3", "A4"
        ]
        && request.resource.data.attendees is map
        && request.resource.data.startTime is string
        && request.resource.data.endTime is string
        && request.resource.data.endTime >
           request.resource.data.startTime;

      // Anyone can update attendance.
      allow update: if
        request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(["attendees"])
        && request.resource.data.attendees is map;

      // Deleting tutorials is disabled.
      allow delete: if false;
    }
  }
}
